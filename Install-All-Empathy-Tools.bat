@echo off
title All Empathy Tools - Install
set "EMP_ME=%~f0"
net session >nul 2>&1
if not errorlevel 1 goto admin
if "%~1"=="" goto elevate
powershell -NoProfile -Command "Start-Process -FilePath $env:EMP_ME -ArgumentList '%~1' -Verb RunAs"
exit /b
:elevate
powershell -NoProfile -Command "Start-Process -FilePath $env:EMP_ME -Verb RunAs"
exit /b
:admin
set "EMP_SELF=%~f0"
set "EMP_ARGS=%*"
powershell -NoProfile -STA -ExecutionPolicy Bypass -Command "iex (([IO.File]::ReadAllText($env:EMP_SELF) -split ('#=='+'PS==#'))[1])"
exit /b
#==PS==#
$UPDATER_BAT = @'
@echo off
title Empathy Tools - Check for updates
set "EMP_UPD_SELF=%~f0"
set "EMP_UPD_DIR=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex (([IO.File]::ReadAllText($env:EMP_UPD_SELF) -split ('#=='+'UP==#'))[1])"
exit /b
#==UP==#
Add-Type -AssemblyName System.Windows.Forms
function Box($m, $b = 'OK') { return [Windows.Forms.MessageBox]::Show($m, 'Empathy Tools', $b) }
function Newer($a, $b) {
  $x = $a.TrimStart('v', 'V').Split('.'); $y = $b.TrimStart('v', 'V').Split('.')
  for ($i = 0; $i -lt [Math]::Max($x.Length, $y.Length); $i++) {
    $p = 0; $q = 0
    if ($i -lt $x.Length) { [void][int]::TryParse($x[$i], [ref]$p) }
    if ($i -lt $y.Length) { [void][int]::TryParse($y[$i], [ref]$q) }
    if ($p -ne $q) { return $p -gt $q }
  }
  return $false
}
$cur = '0'
try { $cur = ([IO.File]::ReadAllText((Join-Path $env:EMP_UPD_DIR 'version.txt'))).Trim() } catch {}
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$ver = $null; $url = $null; $page = 'https://github.com/ioql/EMPATHY-TOOLS'
try {
  $r = Invoke-RestMethod -UseBasicParsing -Uri 'https://api.github.com/repos/ioql/EMPATHY-TOOLS/releases/latest' -Headers @{ 'User-Agent' = 'Empathy-Updater' }
  $a = @($r.assets | Where-Object { $_.name -like '*.bat' })[0]
  if ($a) { $ver = ([string]$r.tag_name).TrimStart('v', 'V'); $url = $a.browser_download_url }
} catch {}
try {
  $rv = (Invoke-WebRequest -UseBasicParsing -Uri ('https://raw.githubusercontent.com/ioql/EMPATHY-TOOLS/main/version.txt?t=' + [DateTime]::UtcNow.Ticks) -Headers @{ 'User-Agent' = 'Empathy-Updater' }).Content.Trim().TrimStart('v', 'V')
  if ($rv -match '^\d+(\.\d+)*$' -and (-not $ver -or (Newer $rv $ver))) { $ver = $rv; $url = 'https://raw.githubusercontent.com/ioql/EMPATHY-TOOLS/main/Install-All-Empathy-Tools.bat' }
} catch {}
if (-not $ver) { [void](Box "Couldn't reach GitHub. Check your internet and try again."); exit }
if (-not (Newer $ver $cur)) { [void](Box "You're up to date (v$cur)."); exit }
if ((Box "Update available: v$ver (you have v$cur). Update now?" 'YesNo') -ne 'Yes') { exit }
$dest = Join-Path $env:TEMP 'Install-All-Empathy-Tools.bat'
try { Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $dest -Headers @{ 'User-Agent' = 'Empathy-Updater' } }
catch { [void](Box ("Download failed: " + $_.Exception.Message)); exit }
Start-Process -FilePath $dest -ArgumentList '/update'
'@

