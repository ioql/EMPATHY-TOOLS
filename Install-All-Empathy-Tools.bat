function Say($m) { $log.AppendText($m + "`r`n"); [Windows.Forms.Application]::DoEvents() }

function Register-Uxp($src, $id, $name) {
  $ver = '1.0.0'
  if ($updating) {
    $cur = Join-Path (Join-Path $env:CommonProgramFiles 'Adobe\UXP\Plugins\External') ($id + '_' + $ver)
    if (Test-Path $cur) { Copy-Item (Join-Path $src '*') $cur -Recurse -Force; return }
  }
  $ext = Join-Path $env:CommonProgramFiles 'Adobe\UXP\Plugins\External'
  New-Item -ItemType Directory -Force -Path $ext | Out-Null
  Get-ChildItem $ext -Directory -Filter "$id*" -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force
  Copy-Item $src (Join-Path $ext ($id + '_' + $ver)) -Recurse -Force
  $info = Join-Path $env:ProgramData 'Adobe\UXP\PluginsInfo\v1'
  New-Item -ItemType Directory -Force -Path $info | Out-Null
  $ppro = Join-Path $info 'PPRO.json'
  $data = $null
  if (Test-Path $ppro) { try { $data = Get-Content $ppro -Raw | ConvertFrom-Json } catch { Copy-Item $ppro "$ppro.bak" -Force } }
  if (-not $data -or -not ($data.PSObject.Properties.Name -contains 'plugins')) { $data = [pscustomobject]@{ plugins = @() } }
  $list = @($data.plugins | Where-Object { $_ -and $_.pluginId -ne $id })
  $list += [pscustomobject]@{ hostMinVersion = '25.6.0'; name = $name; path = ('$localPlugins\External\' + $id + '_' + $ver); pluginId = $id; status = 'enabled'; type = 'uxp'; versionString = $ver }
  $data.plugins = $list
  [IO.File]::WriteAllText($ppro, ($data | ConvertTo-Json -Depth 10), (New-Object Text.UTF8Encoding $false))
}

function Install-FlowSkin($src) {
  $roots = @("${env:CommonProgramFiles(x86)}\Adobe\CEP\extensions", "$env:CommonProgramFiles\Adobe\CEP\extensions", "$env:APPDATA\Adobe\CEP\extensions") |
    Where-Object { $_ -and (Test-Path $_) } | Select-Object -Unique
  $found = @()
  foreach ($r in $roots) {
    foreach ($d in Get-ChildItem -LiteralPath $r -Directory -ErrorAction SilentlyContinue) {
      $m = Join-Path $d.FullName 'CSXS\manifest.xml'
      if ((Test-Path $m) -and ((Get-Content -LiteralPath $m -Raw) -match 'com\.rendertom\.flow')) { $found += $d.FullName }
    }
  }
  if ($found.Count -eq 0) { Say 'FlowSkin: Flow is not installed, skipped.'; return }
  $cssTag = '<link href="flowskin/flowskin.css" rel="stylesheet" />'
  $jsTag = '<script type="text/javascript" src="flowskin/flowskin.js" charset="utf-8"></script>'
  foreach ($f in $found) {
    try {
      $panel = Join-Path $f 'panel'
      if (-not (Test-Path (Join-Path $panel 'index.html'))) { $panel = $f }
      $idx = Join-Path $panel 'index.html'
      if (-not (Test-Path $idx)) { continue }
      $dir = Join-Path $panel 'flowskin'
      New-Item -ItemType Directory -Force -Path $dir | Out-Null
      Copy-Item (Join-Path $src 'flowskin.js') $dir -Force
      Copy-Item (Join-Path $src 'flowskin.css') $dir -Force
      $h = [IO.File]::ReadAllText($idx)
      if ($h -notmatch 'flowskin') {
        if (-not (Test-Path "$idx.backup")) { Copy-Item $idx "$idx.backup" }
        $i = $h.IndexOf('</head>', [StringComparison]::OrdinalIgnoreCase)
        $h = $h.Insert($i, "    $cssTag`r`n")
        $mm = [regex]::Match($h, '<script[^>]*src="[^"]*panel\.js"[^>]*>', 'IgnoreCase')
        if (-not $mm.Success) { $mm = [regex]::Match($h, '<script[^>]*src="js/[^"]*"[^>]*>', 'IgnoreCase') }
        if ($mm.Success) { $h = $h.Insert($mm.Index, "$jsTag`r`n    ") }
        else { $j = $h.LastIndexOf('</body>', [StringComparison]::OrdinalIgnoreCase); $h = $h.Insert($j, "    $jsTag`r`n") }
        [IO.File]::WriteAllText($idx, $h)
      }
      Say ('FlowSkin: installed into ' + (Split-Path $f -Leaf) + '.')
    } catch { Say ('FlowSkin: could not install into ' + $f + ': ' + $_.Exception.Message) }
  }
}

function Install-App($src) {
  $csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework64\v4.0.30319\csc.exe'
  if (-not (Test-Path $csc)) { $csc = Join-Path $env:WINDIR 'Microsoft.NET\Framework\v4.0.30319\csc.exe' }
  if (-not (Test-Path $csc)) { Say 'Empathy app: skipped. Turn on ".NET Framework 4.8 Advanced Services" in "Turn Windows features on or off", then run this again.'; return }
  Get-Process -Name 'Empathy' -ErrorAction SilentlyContinue | ForEach-Object { try { $_.Kill(); $_.WaitForExit(3000) } catch {} }
  $dest = Join-Path $env:LOCALAPPDATA 'Programs\Empathy'
  New-Item -ItemType Directory -Force -Path $dest | Out-Null
  $exe = Join-Path $dest 'Empathy.exe'
  Say 'Empathy app: building (takes a few seconds)...'
  $files = (Get-ChildItem (Join-Path $src '*.cs') | ForEach-Object { '"' + $_.FullName + '"' }) -join ' '
  $argLine = '/nologo /codepage:65001 /target:winexe /optimize+ /main:Empathy.Launch /win32icon:"' + (Join-Path $src 'app.ico') + '" /out:"' + $exe + '" ' +
    '/r:System.dll /r:System.Core.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll /r:System.Web.Extensions.dll ' + $files
  $p = New-Object Diagnostics.Process
  $p.StartInfo.FileName = $csc; $p.StartInfo.Arguments = $argLine
  $p.StartInfo.UseShellExecute = $false; $p.StartInfo.CreateNoWindow = $true; $p.StartInfo.RedirectStandardOutput = $true
  [void]$p.Start(); $out = $p.StandardOutput.ReadToEnd(); $p.WaitForExit()
  if ($p.ExitCode -ne 0 -or -not (Test-Path $exe)) {
    $logFile = Join-Path ([Environment]::GetFolderPath('Desktop')) 'empathy-build-log.txt'
    [IO.File]::WriteAllText($logFile, $out)
    Say 'Empathy app: build failed. Send "empathy-build-log.txt" (on your desktop) to Claude.'
    return
  }
  $sh = New-Object -ComObject WScript.Shell
  foreach ($place in @([Environment]::GetFolderPath('Desktop'), (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs'))) {
    try { $l = $sh.CreateShortcut((Join-Path $place 'Empathy.lnk')); $l.TargetPath = $exe; $l.WorkingDirectory = $dest; $l.IconLocation = "$exe,0"; $l.Save() } catch {}
  }
  Say 'Empathy app: installed. Shortcut on your desktop and in the Start menu.'
}

function Install-UpdateShortcut {
  try {
    $dir = Join-Path $env:LOCALAPPDATA 'Programs\Empathy Tools'
    New-Item -ItemType Directory -Force -Path $dir | Out-Null
    [IO.File]::WriteAllText((Join-Path $dir 'version.txt'), $EMP_VERSION)
    $u = Join-Path $dir 'Check for updates.bat'
    [IO.File]::WriteAllText($u, $UPDATER_BAT)
    $sh = New-Object -ComObject WScript.Shell
    $l = $sh.CreateShortcut((Join-Path (Join-Path ([Environment]::GetFolderPath('StartMenu')) 'Programs') 'Update Empathy Tools.lnk'))
    $l.TargetPath = $u; $l.WorkingDirectory = $dir; $l.IconLocation = "$env:WINDIR\System32\shell32.dll,238"; $l.Save()
  } catch { Say ('Could not add the update shortcut: ' + $_.Exception.Message) }
}

function Install-Extension($src) {
  $dest = Join-Path $env:LOCALAPPDATA 'Programs\Empathy\Browser Extension'
  New-Item -ItemType Directory -Force -Path $dest | Out-Null
  Copy-Item (Join-Path $src '*') $dest -Recurse -Force
  # empathy:// links open the app (the app also does this itself when it starts)
  $exe = Join-Path $env:LOCALAPPDATA 'Programs\Empathy\Empathy.exe'
  try {
    $k = 'HKCU:\Software\Classes\empathy'
    New-Item -Path "$k\shell\open\command" -Force | Out-Null
    Set-ItemProperty -Path $k -Name '(default)' -Value 'URL:Empathy'
    Set-ItemProperty -Path $k -Name 'URL Protocol' -Value ''
    Set-ItemProperty -Path "$k\shell\open\command" -Name '(default)' -Value ('"' + $exe + '" "%1"')
  } catch {}
  if ($updating) { Say 'Browser button: updated. Restart your browser to load it.'; return }
  Say 'Browser button: files ready. One-time setup in your browser:'
  Say '  1. Open chrome://extensions  (Brave: brave://extensions, Edge: edge://extensions)'
  Say '  2. Turn on "Developer mode" (top right)'
  Say '  3. Click "Load unpacked" and pick the folder that just opened'
  Say '  4. Click the puzzle icon and pin Empathy'
  try { Start-Process explorer.exe $dest } catch {}
}

function Copy-Fresh($src, $dst) {
  if ($updating -and (Test-Path $dst)) { Copy-Item (Join-Path $src '*') $dst -Recurse -Force; return }
  if (Test-Path $dst) { Remove-Item $dst -Recurse -Force }
  New-Item -ItemType Directory -Force -Path (Split-Path $dst) | Out-Null
  Copy-Item $src $dst -Recurse -Force
}

$btn.Add_Click({
  $want = @{}; foreach ($k in $boxes.Keys) { $want[$k] = $boxes[$k].Checked }
  if (-not ($want.Values -contains $true)) { Say 'Tick at least one thing to install.'; return }
  $needAE = $want.empathy -or $want.effects -or $want.flowskin
  $needPR = $want.premiere -or $want.prfx
  $aeOpen = [bool](Get-Process -Name 'AfterFX' -ErrorAction SilentlyContinue)
  $prOpen = [bool](Get-Process -Name 'Adobe Premiere Pro' -ErrorAction SilentlyContinue)
  if (-not $updating) {
    if ($needAE -and $aeOpen) { Say 'After Effects is open. Close it, then press Install again.'; return }
    if ($needPR -and $prOpen) { Say 'Premiere Pro is open. Close it, then press Install again.'; return }
  }

  $btn.Enabled = $false; $log.Clear()
  $tmp = Join-Path $env:TEMP ('empathy_' + [guid]::NewGuid().ToString('N'))
  try {
    Say 'Unpacking...'
    $txt = [IO.File]::ReadAllText($self)
    $mB = '-----BEGIN ' + 'CERTIFICATE-----'; $mE = '-----END ' + 'CERTIFICATE-----'
    $s0 = $txt.LastIndexOf($mB) + $mB.Length; $s1 = $txt.LastIndexOf($mE)
    New-Item -ItemType Directory -Path $tmp | Out-Null
    $zip = Join-Path $tmp 'p.zip'
    [IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String(($txt.Substring($s0, $s1 - $s0) -replace '\s', '')))
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [IO.Compression.ZipFile]::ExtractToDirectory($zip, (Join-Path $tmp 'x'))
    $x = Join-Path $tmp 'x'
    $cep = Join-Path $env:APPDATA 'Adobe\CEP\extensions'

    if ($want.empathy) {
      $p = Join-Path $cep 'QuickBox'; if (Test-Path $p) { Remove-Item $p -Recurse -Force }
      Copy-Fresh (Join-Path $x 'ae\Empathy') (Join-Path $cep 'Empathy')
      Say 'Empathy for After Effects: installed.'
    }
    if ($want.effects) { Copy-Fresh (Join-Path $x 'ae\EffectsPlus') (Join-Path $cep 'EffectsPlus'); Say 'Effects+: installed.' }
    $glide = Join-Path $cep 'Glide'
    if ($needAE -and (Test-Path $glide)) { Remove-Item $glide -Recurse -Force; Say 'Removed the old Glide panel.' }

    if ($want.premiere) {
      Copy-Fresh (Join-Path $x 'pr\cep') (Join-Path $cep 'com.empathy.premiere')
      Register-Uxp (Join-Path $x 'pr\uxp') 'com.empathy.premiere.uxp' 'Empathy'
      Say 'Empathy for Premiere: installed (2024 - 26.1 and 26.2+).'
    }
    if ($want.prfx) {
      Copy-Fresh (Join-Path $x 'prfx\cep') (Join-Path $cep 'EffectsPlusPremiere')
      Register-Uxp (Join-Path $x 'prfx\uxp') 'com.empathy.effectsplus.uxp' 'Effects+'
      Say 'Effects+ for Premiere: installed (2024 - 26.1 and 26.2+).'
    }

    if ($want.flowskin) { Install-FlowSkin (Join-Path $x 'flowskin') }
    if ($want.app) { Install-App (Join-Path $x 'app') }
    if ($want.ext) { Install-Extension (Join-Path $x 'ext') }

    Install-UpdateShortcut

    # let Adobe load your own (unsigned) panels
    foreach ($v in 9, 10, 11, 12, 13) { New-Item -Path "HKCU:\Software\Adobe\CSXS.$v" -Force | Out-Null; Set-ItemProperty -Path "HKCU:\Software\Adobe\CSXS.$v" -Name PlayerDebugMode -Value '1' }
    if (Test-Path "$env:TEMP\cep_cache") { Remove-Item "$env:TEMP\cep_cache" -Recurse -Force -ErrorAction SilentlyContinue }

    Say ''
    if ($updating) {
      Say ('Updated to v' + $EMP_VERSION + '.')
      if ($aeOpen -or $prOpen) { Say 'Restart After Effects / Premiere to load the new version.' }
    }
    Say 'All done. Where to find them:'
    if ($want.empathy -or $want.effects) { Say '  After Effects: Window > Extensions > Empathy / Effects+' }
    if ($want.flowskin) { Say '  Flow: click the palette icon next to the star' }
    if ($want.app) { Say '  Empathy app: desktop shortcut' }
    if ($needPR) { Say '  Premiere 2024-26.1: Window > Extensions > Empathy / Effects+'; Say '  Premiere 26.2+:     Window > UXP Plugins > Empathy / Effects+' }
    $btn.Text = 'Done'
  } catch {
    Say ''
    Say ('Something went wrong: ' + $_.Exception.Message)
    Say 'Take a screenshot of this window and send it to Claude.'
    $btn.Enabled = $true
  } finally {
    Remove-Item $tmp -Recurse -Force -ErrorAction SilentlyContinue
  }
})

$form.AcceptButton = $btn
$form.Add_Shown({ $btn.Focus(); if ($updating) { $btn.PerformClick() } })
[void]$form.ShowDialog()
